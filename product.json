{
  "name": "Telegram Profile Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/telegram-age-gender-checker-api",
  "description": "Asynchronous bulk Telegram verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/telegram-age-gender-checker",
  "canonical_docs": "https://docs.numberchecker.ai/telegram-bulk-number-checker-avatar",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "phone"
  },
  "products": [
    {
      "type": "tg_avatar",
      "name": "Profile Checker",
      "min": 1,
      "max": 10000000,
      "fields": [
        "Phone",
        "activated",
        "uid",
        "username",
        "Gender",
        "Age",
        "Ethnicity",
        "Avatar",
        "Last Online Time",
        "Active Days",
        "Is Member",
        "first_name",
        "last_name"
      ],
      "product_id": 27,
      "min_billable_numbers": 1000,
      "available": true
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
